# Copy to .env.local and fill in. Never commit .env.local.

# Random string, 32+ characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Where the app runs. Change to your real domain in production.
BETTER_AUTH_URL=http://localhost:8080

# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Source search runs on Scrapy (https://www.scrapy.org), a Python crawler in /scraper.
# One-time setup: cd scraper && python3 -m venv .venv && .venv/bin/pip install -r requirements.txt
# Optional: a different Python that has Scrapy installed (default: scraper/.venv, then python3)
# SCRAPER_PYTHON=

# Optional: free key from https://openalex.org/settings/api. Adds open-access research
# papers to source searches for college lessons. Without it, those searches skip OpenAlex.
OPENALEX_API_KEY=

# Optional: where the SQLite file lives (default: data/classforward.db)
# DATABASE_PATH=

# Story videos: Claude writes/draws. Narration can use local Piper or ElevenLabs.
# TTS_PROVIDER=piper (requires voice/README.md setup), or elevenlabs (default)
TTS_PROVIDER=elevenlabs
# PIPER_PYTHON=
# PIPER_MODEL=
# From console.anthropic.com > API keys
ANTHROPIC_API_KEY=
# Optional: which Claude model writes and draws (default: claude-sonnet-5-5)
# CLAUDE_MODEL=
# From elevenlabs.io > Developers > API keys
ELEVENLABS_API_KEY=
# Optional: a voice from your ElevenLabs voice library (default: Rachel, 21m00Tcm4TlvDq8ikWAM)
# ELEVENLABS_VOICE_ID=
# Optional: the ElevenLabs speech model (default: eleven_multilingual_v2)
# ELEVENLABS_MODEL_ID=
# Optional: your own ffmpeg (default: the copy installed by npm)
# FFMPEG_PATH=
# Optional: where rendered videos are kept (default: data/videos)
# VIDEO_DIR=

# Jev short-answer evaluation (server only); missing key requires teacher review
TYPESAFE_API_KEY=
# JEV_MODEL=jev-latest
